{
  "name": "electron-liquid-glass",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "description": "Windows Electron WebGL2 liquid glass desktop demo",
  "main": "dist/main.cjs",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "start": "node scripts/launch.mjs",
    "dev": "npm run build && npm start",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts --max-warnings 0",
    "test": "node --import tsx --test tests/*.test.ts tests/glass/*.test.ts",
    "test:gpu": "node scripts/verify-optics.mjs",
    "test:desktop": "node scripts/verify-desktop.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": { "react": "19.2.8", "react-dom": "19.2.8" },
  "devDependencies": {
    "@types/node": "24.10.1", "@types/react": "19.2.14", "@types/react-dom": "19.2.3",
    "electron": "44.3.0", "esbuild": "0.28.2", "eslint": "9.39.1", "@eslint/js": "9.39.1",
    "typescript-eslint": "8.48.1", "tsx": "4.23.12", "typescript": "5.9.3", "playwright": "1.58.2"
  }
}
